# Application
APPLICATION_NAME=banner-deliver
SERVER_PORT=8080

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=banner_deliver
DB_USERNAME=root
DB_PASSWORD=
DB_SERVER_TIMEZONE=Asia/Shanghai
DB_USE_SSL=false
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=false
DB_CONNECT_TIMEOUT_MS=3000
DB_SOCKET_TIMEOUT_MS=5000
DB_POOL_NAME=BannerDeliverHikariPool
DB_POOL_MINIMUM_IDLE=5
DB_POOL_MAXIMUM_SIZE=20
DB_POOL_CONNECTION_TIMEOUT_MS=3000
DB_POOL_VALIDATION_TIMEOUT_MS=1000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=1000
REDIS_POOL_MIN_IDLE=2
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MAX_ACTIVE=16
REDIS_POOL_MAX_WAIT_MS=1000

# Kafka
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_CONSUMER_GROUP=banner-delivery-consumer
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_LISTENER_CONCURRENCY=3
BANNER_EVENT_TOPIC=banner-delivery-event
BANNER_KAFKA_RETRY_BACKOFF_MS=1000

# Banner audience and cache
BANNER_AUDIENCE_TARGET_BUCKET_SIZE=50000
BANNER_AUDIENCE_REDIS_WRITE_BATCH_SIZE=1000
BANNER_LOCAL_CACHE_EXPIRE_SECONDS=30
BANNER_LOCAL_CACHE_MAXIMUM_SIZE=10000
BANNER_REDIS_FALLBACK_DAYS=1
BANNER_REDIS_EXPIRE_AFTER_DATE_DAYS=2
BANNER_REDIS_EXPIRE_JITTER_MAX_SECONDS=300
BANNER_CACHE_ZONE_OFFSET_MILLIS=28800000
BANNER_DEFAULT_ID=0
BANNER_DEFAULT_URL=https://cdn.example.com/default-banner.png

# Reconciliation job
BANNER_RECONCILIATION_ENABLED=true
BANNER_RECONCILIATION_WINDOW_MINUTES=5
BANNER_RECONCILIATION_CRON=0 */5 * * * *

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
MYBATIS_LOG_IMPL=org.apache.ibatis.logging.slf4j.Slf4jImpl
